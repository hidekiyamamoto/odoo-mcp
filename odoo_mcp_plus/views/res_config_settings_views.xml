<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.mcp.plus</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Odoo MCP Plus" string="Odoo MCP Plus" name="odoo_mcp_plus" id="odoo_mcp_plus_settings">
                    <block title="MCP Server" name="odoo_mcp_plus_mcp_server">
                        <setting id="odoo_mcp_plus_mcp_url" string="MCP Endpoint" help="Use this URL to connect an MCP client to this Odoo database.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="odoo_mcp_plus_mcp_url" readonly="1" nolabel="1" class="w-100"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Database Access" name="odoo_mcp_plus_database_access">
                        <setting id="odoo_mcp_plus_sql_enabled" string="Direct SQL" help="Expose a direct PostgreSQL MCP tool. Keep this disabled unless you explicitly need database-level access.">
                            <field name="odoo_mcp_plus_sql_enabled"/>
                            <div class="text-warning mt8" invisible="not odoo_mcp_plus_sql_enabled">
                                Direct SQL access bypasses Odoo ORM protections. Use a restricted PostgreSQL user whenever possible.
                            </div>
                        </setting>
                        <setting id="odoo_mcp_plus_sql_readonly" string="Readonly SQL" help="Refuse write-like SQL operations and open PostgreSQL sessions in readonly mode." invisible="not odoo_mcp_plus_sql_enabled">
                            <field name="odoo_mcp_plus_sql_readonly"/>
                        </setting>
                        <setting id="odoo_mcp_plus_sql_connection" string="SQL Connection" help="PostgreSQL connection used by the direct SQL MCP tool." invisible="not odoo_mcp_plus_sql_enabled">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="odoo_mcp_plus_sql_host" class="col-lg-3 o_light_label"/>
                                    <field name="odoo_mcp_plus_sql_host" placeholder="127.0.0.1"/>
                                </div>
                                <div class="row mt8">
                                    <label for="odoo_mcp_plus_sql_port" class="col-lg-3 o_light_label"/>
                                    <field name="odoo_mcp_plus_sql_port" placeholder="5432"/>
                                </div>
                                <div class="row mt8">
                                    <label for="odoo_mcp_plus_sql_database" class="col-lg-3 o_light_label"/>
                                    <field name="odoo_mcp_plus_sql_database"/>
                                </div>
                                <div class="row mt8">
                                    <label for="odoo_mcp_plus_sql_user" class="col-lg-3 o_light_label"/>
                                    <field name="odoo_mcp_plus_sql_user"/>
                                </div>
                                <div class="row mt8">
                                    <label for="odoo_mcp_plus_sql_password" class="col-lg-3 o_light_label"/>
                                    <field name="odoo_mcp_plus_sql_password" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Custom Tools" name="odoo_mcp_plus_custom_tools">
                        <setting id="odoo_mcp_plus_custom_tools_enabled" string="Allow Custom Tools Creation" help="Expose MCP tools that let an authorized MCP client read, write, reload, and test custom Python MCP tools.">
                            <field name="odoo_mcp_plus_custom_tools_enabled"/>
                            <div class="text-warning mt8" invisible="not odoo_mcp_plus_custom_tools_enabled">
                                Custom tools are executable Python files. Keep this disabled unless you are actively creating or reviewing tools.
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
