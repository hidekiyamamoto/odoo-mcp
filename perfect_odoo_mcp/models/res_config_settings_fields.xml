<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_res_config_settings_mcp_url" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_mcp_url</field>
        <field name="field_description">MCP URL</field>
        <field name="ttype">char</field>
        <field name="readonly">True</field>
    </record>

    <record id="field_res_config_settings_custom_tools_enabled" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_custom_tools_enabled</field>
        <field name="field_description">Allow Custom Tools Creation</field>
        <field name="ttype">boolean</field>
        <field name="help">Expose MCP tools that can read, write, reload, and test custom Python MCP tools.</field>
    </record>

    <record id="field_res_config_settings_sql_enabled" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_enabled</field>
        <field name="field_description">Enable Direct Database Access</field>
        <field name="ttype">boolean</field>
        <field name="help">Expose the direct SQL MCP tool and allow it to connect to PostgreSQL.</field>
    </record>

    <record id="field_res_config_settings_sql_readonly" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_readonly</field>
        <field name="field_description">SQL Readonly</field>
        <field name="ttype">boolean</field>
        <field name="help">When enabled, the SQL tool refuses write operations and opens PostgreSQL sessions in readonly mode.</field>
    </record>

    <record id="field_res_config_settings_sql_host" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_host</field>
        <field name="field_description">SQL Host</field>
        <field name="ttype">char</field>
    </record>

    <record id="field_res_config_settings_sql_port" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_port</field>
        <field name="field_description">SQL Port</field>
        <field name="ttype">integer</field>
    </record>

    <record id="field_res_config_settings_sql_database" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_database</field>
        <field name="field_description">SQL Database</field>
        <field name="ttype">char</field>
    </record>

    <record id="field_res_config_settings_sql_user" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_user</field>
        <field name="field_description">SQL User</field>
        <field name="ttype">char</field>
    </record>

    <record id="field_res_config_settings_sql_password" model="ir.model.fields">
        <field name="model_id" ref="base.model_res_config_settings"/>
        <field name="name">x_perfect_odoo_mcp_sql_password</field>
        <field name="field_description">SQL Password</field>
        <field name="ttype">char</field>
    </record>
</odoo>
