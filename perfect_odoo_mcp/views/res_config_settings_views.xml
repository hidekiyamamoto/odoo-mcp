<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete model="ir.ui.view"
            search="['|', '|', '|', ('arch_db', 'ilike', 'x_perfect_odoo_mcp_'), ('arch_db', 'ilike', 'name=&quot;perfect_odoo_mcp_'), ('arch_db', 'ilike', 'data-key=&quot;perfect_odoo_mcp&quot;'), ('arch_db', 'ilike', 'name=&quot;perfect_odoo_mcp&quot;')]"/>
    <delete model="ir.model.fields"
            search="[('model', '=', 'res.config.settings'), ('name', 'ilike', 'x_perfect_odoo_mcp_')]"/>
    <delete model="ir.actions.act_url"
            search="[('url', '=', '/perfect_odoo_mcp/settings')]"/>
    <delete model="ir.ui.menu"
            search="[('name', '=', 'Perfect Odoo MCP')]"/>
    <delete model="ir.actions.act_window"
            search="[('name', '=', 'Perfect Odoo MCP'), ('res_model', '=', 'res.config.settings')]"/>
    <record id="editable_module_view_tree" model="ir.ui.view">
        <field name="name">perfect.odoo.mcp.editable.module.tree</field>
        <field name="model">perfect.odoo.mcp.editable.module</field>
        <field name="arch" type="xml">
            <list string="Editable Modules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="module_id"/>
                <field name="module_name"/>
                <field name="addons_dir" readonly="1"/>
                <field name="module_path" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="editable_module_view_form" model="ir.ui.view">
        <field name="name">perfect.odoo.mcp.editable.module.form</field>
        <field name="model">perfect.odoo.mcp.editable.module</field>
        <field name="arch" type="xml">
            <form string="Editable Module">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="module_id"/>
                        <field name="module_name" readonly="1"/>
                        <field name="addons_dir" readonly="1"/>
                        <field name="module_path" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_editable_modules" model="ir.actions.act_window">
        <field name="name">Editable Modules</field>
        <field name="res_model">perfect.odoo.mcp.editable.module</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_perfect_odoo_mcp_editable_modules"
              name="Editable Modules"
              parent="base.menu_config"
              action="action_editable_modules"
              sequence="91"
              groups="base.group_system"/>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.perfect.odoo.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 17+ settings use the app/block/setting layout. Older branches keep the legacy app_settings_block view. -->
            <xpath expr="//form" position="inside">
                <app data-string="Perfect Odoo MCP" string="Perfect Odoo MCP" name="perfect_odoo_mcp" id="perfect_odoo_mcp_settings">
                    <block title="MCP Server" name="perfect_odoo_mcp_mcp_server">
                        <setting id="perfect_odoo_mcp_mcp_url" string="MCP Endpoint" help="Use this URL to connect an MCP client to this Odoo database.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="perfect_odoo_mcp_mcp_url" readonly="1" nolabel="1" class="w-100"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="perfect_odoo_mcp_custom_tools_enabled" string="Allow Custom Tools Creation" help="Expose MCP tools that let an authorized MCP client read, write, reload, and test custom Python MCP tools.">
                            <field name="perfect_odoo_mcp_custom_tools_enabled"/>
                            <div class="text-warning mt8" invisible="not perfect_odoo_mcp_custom_tools_enabled">
                                Custom tools are executable Python files. Keep this disabled unless you are actively creating or reviewing tools.
                            </div>
                        </setting>
                    </block>

                    <block title="Module Editing" name="perfect_odoo_mcp_module_editing">
                        <setting id="perfect_odoo_mcp_module_editing_enabled" string="Enable Modules Editing" help="Expose one MCP tool that can list, read, write, and delete files inside explicitly allowlisted module folders.">
                            <field name="perfect_odoo_mcp_module_editing_enabled"/>
                            <div class="text-warning mt8" invisible="not perfect_odoo_mcp_module_editing_enabled">
                                Module editing changes Python/XML/data files on disk. Keep this disabled unless you are actively reviewing code edits.
                            </div>
                        </setting>
                        <setting id="perfect_odoo_mcp_module_editing_modules" string="Editable Modules" help="Choose the installed modules that the MCP module editor may modify. The module folder and addons directory are detected automatically.">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(action_editable_modules)d" type="action" string="Open Editable Modules" class="btn btn-secondary"/>
                                </div>
                                <div class="text-muted mt8">
                                    Legacy JSON config is still read only when no editable module records exist.
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Database Access" name="perfect_odoo_mcp_database_access">
                        <setting id="perfect_odoo_mcp_sql_enabled" string="Direct SQL" help="Expose a direct PostgreSQL MCP tool. Keep this disabled unless you explicitly need database-level access.">
                            <field name="perfect_odoo_mcp_sql_enabled"/>
                            <div class="text-warning mt8" invisible="not perfect_odoo_mcp_sql_enabled">
                                Direct SQL access bypasses Odoo ORM protections. Use a restricted PostgreSQL user whenever possible.
                            </div>
                        </setting>
                        <setting id="perfect_odoo_mcp_sql_readonly" string="Readonly SQL" help="Refuse write-like SQL operations and open PostgreSQL sessions in readonly mode." invisible="not perfect_odoo_mcp_sql_enabled">
                            <field name="perfect_odoo_mcp_sql_readonly"/>
                        </setting>
                        <setting id="perfect_odoo_mcp_sql_connection" string="SQL Connection" help="PostgreSQL connection used by the direct SQL MCP tool." invisible="not perfect_odoo_mcp_sql_enabled">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="perfect_odoo_mcp_sql_host" class="col-lg-3 o_light_label"/>
                                    <field name="perfect_odoo_mcp_sql_host" placeholder="127.0.0.1"/>
                                </div>
                                <div class="row mt8">
                                    <label for="perfect_odoo_mcp_sql_port" class="col-lg-3 o_light_label"/>
                                    <field name="perfect_odoo_mcp_sql_port" placeholder="5432"/>
                                </div>
                                <div class="row mt8">
                                    <label for="perfect_odoo_mcp_sql_database" class="col-lg-3 o_light_label"/>
                                    <field name="perfect_odoo_mcp_sql_database"/>
                                </div>
                                <div class="row mt8">
                                    <label for="perfect_odoo_mcp_sql_user" class="col-lg-3 o_light_label"/>
                                    <field name="perfect_odoo_mcp_sql_user"/>
                                </div>
                                <div class="row mt8">
                                    <label for="perfect_odoo_mcp_sql_password" class="col-lg-3 o_light_label"/>
                                    <field name="perfect_odoo_mcp_sql_password" password="True"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
