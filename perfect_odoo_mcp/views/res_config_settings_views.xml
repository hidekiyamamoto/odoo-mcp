<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete model="ir.ui.view"
            search="['|', ('name', '=', 'res.config.settings.view.form.inherit.perfect.odoo.mcp'), ('arch_db', 'ilike', 'perfect_odoo_mcp_')]"/>
    <delete model="ir.actions.act_url"
            search="[('url', '=', '/perfect_odoo_mcp/settings')]"/>
    <delete model="ir.attachment"
            search="[('url', 'like', '/web/assets/%'), '|', ('name', 'ilike', 'web.assets_backend'), ('url', 'ilike', 'web.assets_backend')]"/>

    <record id="action_perfect_odoo_mcp_settings_window" model="ir.actions.act_window">
        <field name="name">Perfect Odoo MCP</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'perfect_odoo_mcp'}</field>
    </record>

    <menuitem id="menu_perfect_odoo_mcp_settings"
              name="Perfect Odoo MCP"
              parent="base.menu_administration"
              action="action_perfect_odoo_mcp_settings_window"
              sequence="95"/>
</odoo>
