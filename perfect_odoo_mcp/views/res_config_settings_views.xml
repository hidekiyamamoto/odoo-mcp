<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete model="ir.ui.view"
            search="['|', '|', '|', ('arch_db', 'ilike', 'x_perfect_odoo_mcp_'), ('arch_db', 'ilike', 'name=&quot;perfect_odoo_mcp_'), ('arch_db', 'ilike', 'data-key=&quot;perfect_odoo_mcp&quot;'), ('arch_db', 'ilike', 'name=&quot;perfect_odoo_mcp&quot;')]"/>
    <delete model="ir.model.fields"
            search="[('model', '=', 'res.config.settings'), ('name', 'ilike', 'x_perfect_odoo_mcp_')]"/>
    <delete model="ir.actions.act_url"
            search="[('url', '=', '/perfect_odoo_mcp/settings')]"/>
    <delete model="ir.ui.menu"
            search="[('name', '=', 'Perfect Odoo MCP')]"/>
    <delete model="ir.actions.act_window"
            search="[('name', '=', 'Perfect Odoo MCP'), ('res_model', '=', 'res.config.settings')]"/>
    <record id="editable_module_view_tree" model="ir.ui.view">
        <field name="name">perfect.odoo.mcp.editable.module.tree</field>
        <field name="model">perfect.odoo.mcp.editable.module</field>
        <field name="arch" type="xml">
            <tree string="Editable Modules" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="active"/>
                <field name="module_id"/>
                <field name="module_name"/>
                <field name="addons_dir" readonly="1"/>
                <field name="module_path" readonly="1"/>
                <field name="module_path_source" readonly="1" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="editable_module_view_form" model="ir.ui.view">
        <field name="name">perfect.odoo.mcp.editable.module.form</field>
        <field name="model">perfect.odoo.mcp.editable.module</field>
        <field name="arch" type="xml">
            <form string="Editable Module">
                <sheet>
                    <group>
                        <field name="active"/>
                        <field name="module_id"/>
                        <field name="module_name" readonly="1"/>
                        <field name="addons_dir" readonly="1"/>
                        <field name="module_path" readonly="1"/>
                        <field name="module_path_source" readonly="1"/>
                        <field name="module_path_candidates" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_editable_modules" model="ir.actions.act_window">
        <field name="name">Editable Modules</field>
        <field name="res_model">perfect.odoo.mcp.editable.module</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_perfect_odoo_mcp_editable_modules"
              name="Editable Modules"
              parent="base.menu_config"
              action="action_editable_modules"
              sequence="91"
              groups="base.group_system"/>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.perfect.odoo.mcp</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Odoo 14-16 settings use the legacy app_settings_block layout. Newer branches use app/block/setting. -->
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Perfect Odoo MCP" string="Perfect Odoo MCP" data-key="perfect_odoo_mcp">
                    <h2>MCP Server</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_mcp_url">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="perfect_odoo_mcp_mcp_url"/>
                                <div class="text-muted">Use this URL to connect an MCP client to this Odoo database.</div>
                                <div class="content-group mt16">
                                    <field name="perfect_odoo_mcp_mcp_url" readonly="1" nolabel="1" class="w-100"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_custom_tools_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="perfect_odoo_mcp_custom_tools_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="perfect_odoo_mcp_custom_tools_enabled"/>
                                <div class="text-muted">Expose MCP tools that let an authorized MCP client read, write, reload, and test custom MCP tools.</div>
                                <div class="text-warning mt8" attrs="{'invisible': [('perfect_odoo_mcp_custom_tools_enabled', '=', False)]}">
                                    Custom MCP tools are executable Python files. Keep this disabled unless you are actively creating or reviewing tools.
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Module Editing</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_module_editing_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="perfect_odoo_mcp_module_editing_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="perfect_odoo_mcp_module_editing_enabled"/>
                                <div class="text-muted">Expose one MCP tool that can list, read, write, and delete files inside explicitly allowlisted module folders.</div>
                                <div class="text-warning mt8" attrs="{'invisible': [('perfect_odoo_mcp_module_editing_enabled', '=', False)]}">
                                    Module editing changes Python/XML/data files on disk. Keep this disabled unless you are actively reviewing code edits.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_module_editing_modules_setting">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Editable Modules</span>
                                <div class="text-muted">Choose the installed modules that the MCP module editor may modify. The module folder and addons directory are detected automatically.</div>
                                <div class="content-group mt16">
                                    <button name="%(action_editable_modules)d" type="action" string="Open Editable Modules" class="btn btn-secondary"/>
                                </div>
                                <div class="text-muted mt8">
                                    Legacy JSON config is still read only when no editable module records exist.
                                </div>
                            </div>
                        </div>
                    </div>

                    <h2>Database Access</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_sql_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="perfect_odoo_mcp_sql_enabled"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="perfect_odoo_mcp_sql_enabled"/>
                                <div class="text-muted">Expose a direct PostgreSQL MCP tool. Keep this disabled unless you explicitly need database-level access.</div>
                                <div class="text-warning mt8" attrs="{'invisible': [('perfect_odoo_mcp_sql_enabled', '=', False)]}">
                                    Direct SQL access bypasses Odoo ORM protections. Use a restricted PostgreSQL user whenever possible.
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_sql_readonly_setting" attrs="{'invisible': [('perfect_odoo_mcp_sql_enabled', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="perfect_odoo_mcp_sql_readonly"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="perfect_odoo_mcp_sql_readonly"/>
                                <div class="text-muted">Refuse write-like SQL operations and open PostgreSQL sessions in readonly mode.</div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box" id="perfect_odoo_mcp_sql_connection_setting" attrs="{'invisible': [('perfect_odoo_mcp_sql_enabled', '=', False)]}">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">SQL Connection</span>
                                <div class="text-muted">PostgreSQL connection used by the direct SQL MCP tool.</div>
                                <div class="content-group mt16">
                                    <div class="row mt8">
                                        <label for="perfect_odoo_mcp_sql_host" class="col-lg-3 o_light_label"/>
                                        <field name="perfect_odoo_mcp_sql_host" placeholder="127.0.0.1"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="perfect_odoo_mcp_sql_port" class="col-lg-3 o_light_label"/>
                                        <field name="perfect_odoo_mcp_sql_port" placeholder="5432"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="perfect_odoo_mcp_sql_database" class="col-lg-3 o_light_label"/>
                                        <field name="perfect_odoo_mcp_sql_database"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="perfect_odoo_mcp_sql_user" class="col-lg-3 o_light_label"/>
                                        <field name="perfect_odoo_mcp_sql_user"/>
                                    </div>
                                    <div class="row mt8">
                                        <label for="perfect_odoo_mcp_sql_password" class="col-lg-3 o_light_label"/>
                                        <field name="perfect_odoo_mcp_sql_password" password="True"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
