<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <delete model="ir.ui.view"
            search="['|', ('name', '=', 'res.config.settings.view.form.inherit.perfect.odoo.mcp'), ('arch_db', 'ilike', 'perfect_odoo_mcp_mcp_url')]"/>
    <delete model="ir.attachment"
            search="[('url', 'like', '/web/assets/%'), '|', ('name', 'ilike', 'web.assets_backend'), ('url', 'ilike', 'web.assets_backend')]"/>

    <record id="action_perfect_odoo_mcp_settings_url" model="ir.actions.act_url">
        <field name="name">Perfect Odoo MCP</field>
        <field name="url">/perfect_odoo_mcp/settings</field>
        <field name="target">self</field>
    </record>

    <menuitem id="menu_perfect_odoo_mcp_settings"
              name="Perfect Odoo MCP"
              parent="base.menu_administration"
              action="action_perfect_odoo_mcp_settings_url"
              sequence="95"/>
</odoo>
